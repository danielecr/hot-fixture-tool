# Server Configuration
SERVER_ADDRESS=:8080

# DBMS Providers Configuration
DBMS_PROVIDERS=MYSQL1,MYSQL2,POSTGRES1

# Database Configuration
MYSQL1.DB_TYPE=mysql
MYSQL1.DB_HOST=localhost
MYSQL1.DB_PORT=3306
MYSQL1.DB_USER=your_db_user
MYSQL1.DB_PASSWORD=your_db_password
MYSQL1.DB_NAME=your_database_name

MYSQL2.DB_TYPE=mysql
MYSQL2.DB_HOST=localhost
MYSQL2.DB_PORT=3306
MYSQL2.DB_USER=your_db_user
MYSQL2.DB_PASSWORD=your_db_password
MYSQL2.DB_NAME=your_database_name

POSTGRES1.DB_TYPE=postgres
POSTGRES1.DB_HOST=localhost
POSTGRES1.DB_PORT=5432
POSTGRES1.DB_USER=your_db_user
POSTGRES1.DB_PASSWORD=your_db_password
POSTGRES1.DB_NAME=your_database_name

# Volume Configuration
VOLUMES=volume1,volume2
VOLUME1.PATH=/path/to/volume1
VOLUME2.PATH=/path/to/volume2

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication Configuration
# Generate a strong random secret for JWT signing
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Admin Configuration
HFITD_SOCKET_PATH=/tmp/hfitd.sock